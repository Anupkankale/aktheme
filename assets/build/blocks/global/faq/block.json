{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ak/faq",
  "title": "AK FAQ",
  "category": "ak",
  "icon": "editor-help",
  "description": "Accordion of Details blocks (first 5 shown, See More for the rest); outputs FAQPage structured data.",
  "keywords": [
    "ak",
    "section"
  ],
  "version": "1.0.0",
  "textdomain": "aktheme",
  "supports": {
    "anchor": true,
    "html": false,
    "align": [
      "full"
    ]
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    }
  },
  "ak": {
    "tagName": "section",
    "className": "section faq",
    "anchor": "faq"
  },
  "editorScript": "file:./index.js",
  "style": [
    "ak-base",
    "file:./style-index.css"
  ],
  "viewScript": "file:./view.js",
  "styles": [
    {
      "name": "default",
      "label": "Default",
      "isDefault": true
    },
    {
      "name": "compact",
      "label": "Compact"
    },
    {
      "name": "home",
      "label": "Home"
    }
  ]
}