{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ak/step-cards",
  "title": "AK Step Cards",
  "category": "ak",
  "icon": "grid-view",
  "description": "Header, then numbered step cards in two columns (navy and light, alternating), each with a gold tag, title, text and photo.",
  "keywords": [
    "ak",
    "section"
  ],
  "version": "1.0.0",
  "textdomain": "aktheme",
  "supports": {
    "anchor": true,
    "html": false,
    "align": [
      "full"
    ]
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    }
  },
  "ak": {
    "tagName": "section",
    "className": "section step-cards",
    "anchor": "research-steps"
  },
  "editorScript": "file:./index.js",
  "style": [
    "ak-base",
    "file:./style-index.css"
  ],
  "styles": [
    {
      "name": "default",
      "label": "Default",
      "isDefault": true
    },
    {
      "name": "home",
      "label": "Home"
    }
  ],
  "viewScript": "file:./view.js"
}