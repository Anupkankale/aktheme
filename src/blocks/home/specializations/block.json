{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ak/specializations",
	"title": "AK Specializations",
	"category": "ak",
	"icon": "tag",
	"description": "Our Programs: linked program cards, 4 per view, continuous marquee scroll.",
	"keywords": [
		"ak",
		"section"
	],
	"version": "1.0.0",
	"textdomain": "aktheme",
	"supports": {
		"anchor": true,
		"html": false,
		"align": [
			"full"
		]
	},
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"ak": {
		"tagName": "section",
		"className": "section specs",
		"anchor": "specializations"
	},
	"editorScript": "file:./index.js",
	"style": [
		"ak-base",
		"file:./style-index.css"
	],
	"viewScript": "file:./view.js",
	"styles": [
		{
			"name": "default",
			"label": "Four per view (scrolling)",
			"isDefault": true
		},
		{
			"name": "five",
			"label": "Five per row"
		},
		{
			"name": "home",
			"label": "Home"
		}
	]
}
