{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ak/tabs",
	"title": "AK Tabs",
	"category": "ak",
	"icon": "index-card",
	"description": "Header, a row of tab labels and one panel per label (e.g. Skills / Who should do / Careers / Tools). The first tab is open.",
	"keywords": [
		"ak",
		"section",
		"tabs"
	],
	"version": "1.0.0",
	"textdomain": "aktheme",
	"supports": {
		"anchor": true,
		"html": false,
		"align": [
			"full"
		]
	},
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"ak": {
		"tagName": "section",
		"className": "section tabs",
		"anchor": "learn-more"
	},
	"editorScript": "file:./index.js",
	"style": [
		"ak-base",
		"file:./style-index.css"
	],
	"viewScript": "file:./view.js",
	"styles": [
		{
			"name": "default",
			"label": "Default",
			"isDefault": true
		},
		{
			"name": "home",
			"label": "Home"
		}
	]
}
