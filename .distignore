# Files left out of the installable theme (bin/package.sh, rsync --exclude-from). Patterns starting with / are relative
# to the repo root, so vendor packages keep their own src/, tests/ and docs. assets/build and vendor/ (no dev packages)
# ARE included.

# Git and GitHub
.git*
/.github

# Source, tests and docs
/src
/tests
/docs
/bin
/dist
*.md

# Dependencies installed only for building
/node_modules

# Tooling config
/.editorconfig
/.nvmrc
/.env*
/.wp-env*
/.stylelint*
/.eslint*
/.prettier*
/.husky
/.browserslistrc
/.lintstagedrc*
/.distignore
/.npmrc
/.wp-scaffold.json
/phpcs.xml*
/phpstan*
/phpunit.xml*
/eslint.config.*
/stylelint.config.*
/webpack*.js
/babel.config.js
/package.json
/package-lock.json
/composer.json
/composer.lock
/tailwind.config.*

# Misc
.DS_Store
*.log
*.map
